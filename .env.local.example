# Kit (旧ConvertKit) 連携用
# APIキーは絶対にNEXT_PUBLIC_を付けないこと(サーバーのみで使用)
KIT_API_KEY=
KIT_FORM_ID=
# 「Hormone Intelligence」タグのID(全登録者に付与)
KIT_TAG_ID_HORMONE_INTELLIGENCE=
# 流入元を保存するカスタムフィールドのキー名(例: source_channel)
KIT_SOURCE_FIELD_KEY=

# Hormone Journey (/journey/video) の表示設定
# YouTube限定公開動画の埋め込み用URL(例: https://www.youtube.com/embed/xxxxxxxxxxx)
JOURNEY_VIDEO_URL=
# 唾液ホルモン検査案内ページのURL
JOURNEY_TEST_URL=
# 検査案内CTAボタンの文言(未設定時は既定文言を使用)
JOURNEY_CTA_LABEL=
# CTA下の説明文(未設定時は既定文言を使用)
JOURNEY_CTA_DESCRIPTION=

# GA4 (未設定でもアプリはエラーにならない)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
